{
    "schema_version": 3,
    "profiles": {
        "*": {
            "jitter": {
                "enabled": true
            },
            "upscale": {
                "enabled": true,
                "internal_format": "rgba16f",
                "hdr": true,
                "auto_exposure": false,
                "motion_jittered": false,
                "trigger": {
                    "type": "BEFORE",
                    "pass": "composite6"
                },
                "disabled_algorithms": ["fsr1", "sgsr1", "sgsr2", "dlssrr"],
                "inputs": {
                    "color": {
                        "enabled": true,
                        "src": "autotex3",
                        "region": [0, 0, -1, -1]
                    },
                    "depth": {
                        "enabled": true,
                        "src": "depthtex",
                        "region": [0, 0, -1, -1]
                    },
                    "motion_vectors": {
                        "enabled": true,
                        "src": "autotex19",
                        "region": [0, 0, -1, -1]
                    },
                    "exposure": {
                        "enabled": true,
                        "src": "autotex21",
                        "region": [0, 0, 1, 1]
                    }
                },
                "outputs": {
                    "upscaled_color": {
                        "enabled": true,
                        "target": ["autotex20"],
                        "region": [0, 0, -2, -2]
                    }
                }
            }
        }
    }
}
